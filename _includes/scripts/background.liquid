<!-- Dynamic Background -->
<script src="{{ '/assets/js/backgrounds/shared.js' | relative_url }}"></script>
<script>
(function() {
  if (window.lenis) return;
  var ls = document.createElement('script');
  ls.src = 'https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js';
  ls.onload = function() {
    window.lenis = new Lenis({ duration: 0, syncTouch: true, wheelMultiplier: 1 });
    window.lenisScroll = 0;
    window.lenis.on('scroll', function(e) { window.lenisScroll = e.animatedScroll; });
    function lenisRaf(t) { window.lenis.raf(t); requestAnimationFrame(lenisRaf); }
    requestAnimationFrame(lenisRaf);
    var bs = document.createElement('script');
    bs.src = '{{ page.background | default: "stars" | prepend: "/assets/js/backgrounds/" | append: ".js" | relative_url }}';
    document.body.appendChild(bs);
  };
  document.body.appendChild(ls);
})();
</script>