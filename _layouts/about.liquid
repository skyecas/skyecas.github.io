---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        {% assign parts = site.pronouns | split: "/" %}
        {% assign pronouns = "" %}
        {% for part in parts %}
          {% assign trimmed = part | strip %}
          {% if forloop.first %}
            {% assign pronouns = trimmed %}
          {% else %}
            {% assign pronouns = pronouns | append: " / " | append: trimmed %}
          {% endif %}
        {% endfor %}

        <span style="display: inline-block;">{{ site.first_name }}</span>{% if site.middle_name and site.middle_name != "" %} <span style="display: inline-block; font-style: italic; font-weight: 300;">{{ site.middle_name }}</span>{% endif %} <span style="display: inline-block; color: var(--global-theme-color);">{{ site.last_name }}</span><br>
        <span style="font-size: 0.55em; color: var(--global-theme-color);">{{ site.post_nomials }}</span><br>
        <span style="font-size: 0.55em; font-style: italic; color: var(--global-theme-color);">{{ pronouns }}</span>
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid path = profile_image_path class = profile_image_class sizes = sizes alt = page.profile.image
            cache_bust = true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_repos %}
      <h2>
        <a href="{{ '/repositories/' | relative_url }}" style="color: inherit">selected repositories</a>
      </h2>
      {% include selected_repos.liquid %}
    {% endif %}

    <!-- Self gallery -->
    {% assign container_width = 800 %}
    {% assign gap = 10 %}
    {% assign aspect_ratio_inverse = 13 | divided_by: 6 %}

    {%- assign profile_images = "" | split: "" -%}

    {%- for image in site.static_files -%}
        {%- if image.path contains '/profiles/' and (image.extname == '.jpg' or image.extname == '.png' or image.extname == '.jpeg' or image.extname == '.webp') -%}
            {%- assign profile_images = profile_images | push: image -%}
        {%- endif -%}
    {%- endfor -%}

    {%- assign row_size = 4 -%}
    {%- assign total_images = profile_images.size -%}
    {%- assign rows = total_images | divided_by: row_size | ceil -%}

    {%- for i in (0..rows) -%}
        {%- assign start_index = i | times: row_size -%}
        {%- assign end_index = start_index | plus: row_size | minus: 1 -%}
        {%- assign row_images = "" | split: "" -%}

        {%- for j in (start_index..end_index) -%}
            {%- if j < total_images -%}
            {%- assign row_images = row_images | push: profile_images[j] -%}
            {%- endif -%}
        {%- endfor -%}

        {%- assign image_count = row_images.size -%}
        {%- if image_count > 0 -%}
        {%- assign image_count_minus_1 = image_count | minus: 1 -%}
        {%- assign total_gap = gap | times: image_count_minus_1 -%}
        {%- assign usable_width = container_width | minus: total_gap -%}
        {%- if image_count == 1 -%}
            {%- assign image_width = usable_width | divided_by: 2 -%}
        {%- else -%}
            {%- assign image_width = usable_width | divided_by: image_count -%}
        {%- endif -%}
        {%- assign image_height = image_width | times: aspect_ratio_inverse | floor -%}

        <div style="display:flex; gap: {{ gap }}px; justify-content: center; overflow:hidden; height: {{ image_height }}px; margin-bottom: {{ gap }}px;">
            {%- for image in row_images -%}
            {% assign parts = image.name | split: "-" %}
            {% if parts.size == 3 %}
                {% assign year = parts[0] %}
                {% assign month = parts[1] %}
                <a href="/blog/{{ year }}/{{ month }}-sprint/" style="height: inherit;">
                <img src="{{ image.path | relative_url }}" alt="{{ year }}-{{ month }}" style="width: auto; height: inherit; flex-grow:1; object-fit: cover; object-position: center; aspect-ratio: 6 / 13;" />
                </a>
            {% else %}
                <img src="{{ image.path | relative_url }}" alt="{{ image.name }}" style="width: auto; height: inherit; flex-grow:1; object-fit: cover; object-position: center; aspect-ratio: 6 / 13;" />
            {% endif %}
            {%- endfor -%}
        </div>
        {%- endif -%}
    {%- endfor -%}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include footer_social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

  </article>
</div>
